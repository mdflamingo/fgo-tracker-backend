{
    "swagger": "2.0",
    "info": {
        "description": "API for task tracker",
        "title": "Task Tracker API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "support@example.com"
        },
        "version": "1.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/task": {
            "post": {
                "description": "Creates a new task with optional assignee and reviewer",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tasks"
                ],
                "summary": "Create new task",
                "parameters": [
                    {
                        "description": "Task data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.TaskCreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created task ID",
                        "schema": {
                            "$ref": "#/definitions/model.TaskCreateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/task/list": {
            "get": {
                "description": "Return all tasks in system",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tasks"
                ],
                "summary": "Get all tasks",
                "responses": {
                    "200": {
                        "description": "Tasks",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.TaskListResponse"
                            }
                        }
                    },
                    "204": {
                        "description": "Tasks not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/task/{id}": {
            "get": {
                "description": "Returns information about a specific task",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tasks"
                ],
                "summary": "Get task by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Task found",
                        "schema": {
                            "$ref": "#/definitions/model.TaskResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid task ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Task not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Updates information about the existing task",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Task"
                ],
                "summary": "Task update",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Data for update",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.TaskUpdateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful task update\"s",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Invalid task ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Task not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Delete task by ID",
                "tags": [
                    "Tasks"
                ],
                "summary": "Delete task",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful task deletion",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Invalid task ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Task not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.ProjectDB": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "model.TaskCreateRequest": {
            "type": "object",
            "required": [
                "assigned_id",
                "deadline",
                "description",
                "name",
                "priority",
                "project_id",
                "reviewer_id",
                "status"
            ],
            "properties": {
                "assigned_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "deadline": {
                    "type": "string",
                    "example": "2025-07-01T00:00:00Z"
                },
                "description": {
                    "type": "string",
                    "example": "Some description"
                },
                "name": {
                    "type": "string",
                    "example": "Update user table"
                },
                "priority": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskPriority"
                        }
                    ],
                    "example": "medium"
                },
                "project_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "reviewer_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskStatus"
                        }
                    ],
                    "example": "backlog"
                }
            }
        },
        "model.TaskCreateResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                }
            }
        },
        "model.TaskListResponse": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Some description"
                },
                "id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "name": {
                    "type": "string",
                    "example": "Update user table"
                },
                "priority": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskPriority"
                        }
                    ],
                    "example": "medium"
                },
                "project_name": {
                    "type": "string"
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskStatus"
                        }
                    ],
                    "example": "backlog"
                }
            }
        },
        "model.TaskPriority": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "critical"
            ],
            "x-enum-varnames": [
                "TaskPriorityLow",
                "TaskPriorityMedium",
                "TaskPriorityHigh",
                "TaskPriorityCritical"
            ]
        },
        "model.TaskResponse": {
            "type": "object",
            "properties": {
                "assignees": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.UserDB"
                    }
                },
                "completed": {
                    "type": "string",
                    "example": "2025-07-01T00:00:00Z"
                },
                "creator": {
                    "$ref": "#/definitions/model.UserDB"
                },
                "deadline": {
                    "type": "string",
                    "example": "2025-07-01T00:00:00Z"
                },
                "description": {
                    "type": "string",
                    "example": "Some description"
                },
                "id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "name": {
                    "type": "string",
                    "example": "Update user table"
                },
                "priority": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskPriority"
                        }
                    ],
                    "example": "medium"
                },
                "project": {
                    "$ref": "#/definitions/model.ProjectDB"
                },
                "reviewers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.UserDB"
                    }
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskStatus"
                        }
                    ],
                    "example": "backlog"
                }
            }
        },
        "model.TaskStatus": {
            "type": "string",
            "enum": [
                "backlog",
                "in_progress",
                "review",
                "done"
            ],
            "x-enum-varnames": [
                "TaskStatusBacklog",
                "TaskStatusInProgress",
                "TaskStatusReview",
                "TaskStatusDone"
            ]
        },
        "model.TaskUpdateRequest": {
            "type": "object",
            "required": [
                "deadline"
            ],
            "properties": {
                "assigned_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "completed_at": {
                    "type": "string",
                    "example": "2025-07-01T00:00:00Z"
                },
                "deadline": {
                    "type": "string",
                    "example": "2025-07-01T00:00:00Z"
                },
                "description": {
                    "type": "string",
                    "example": "Some description"
                },
                "name": {
                    "type": "string",
                    "example": "Update user table"
                },
                "priority": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskPriority"
                        }
                    ],
                    "example": "medium"
                },
                "project_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "reviewer_id": {
                    "type": "string",
                    "example": "60601fee-2bf1-4721-ae6f-7636e79a0cba"
                },
                "status": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.TaskStatus"
                        }
                    ],
                    "example": "backlog"
                }
            }
        },
        "model.UserDB": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    }
}